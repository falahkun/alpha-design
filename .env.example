# Local preview bridge
PREVIEW_PORT=8787
PREVIEW_ROOT=agent-workspace

# Optional explicit agent adapters.
# JSON object of argv arrays. No shell is used.
# Supported placeholders: {{promptFile}}, {{jobId}}, {{root}}, {{states}}
# Fill these with the exact CLI invocation available on your machine.
AKSA_AGENT_COMMANDS_JSON={"claude":["YOUR_CLAUDE_COMMAND","{{promptFile}}"],"codex":["YOUR_CODEX_COMMAND","{{promptFile}}"],"antigravity":["YOUR_ANTIGRAVITY_COMMAND","{{promptFile}}"]}

# MCP server can use the bridge for history-aware publishing.
AKSA_BRIDGE_URL=http://127.0.0.1:8787
